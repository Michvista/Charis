#  Postgres
POSTGRES_DB=charis
POSTGRES_USER=charis_user
POSTGRES_PASSWORD=yourpassword
DATABASE_URL=postgresql://charis_user:yourpassword@postgres:5432/charis

#  Redis
# Use local Redis when running via docker compose (see docker-compose.yml).
# Use Upstash only in production/staging — BullMQ polling burns free-tier quota fast.
REDIS_URL=redis://redis:6379

#  Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_SCHEMA=django
DJANGO_INTERNAL_URL=http://localhost:8000

#  DolphJS styling-service ─
JWT_SECRET=same-secret-as-django
STYLING_SERVICE_URL=http://styling-service:3300
STYLING_SERVICE_PORT=3300
STYLING_SERVICE_INTERNAL_URL=http://localhost:3000
DATABASE_SCHEMA=styling_service

#  Job worker 
INTERNAL_API_KEY=shared-secret-between-services

#  AI
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: server-side Gemini File Search Store resource name (e.g. fileSearchStores/abc123).
# When unset, the Style Advisor creates one store with display name "charis-style-knowledge" and reuses it.
GEMINI_RAG_STORE=

#  Cloudinary 
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
